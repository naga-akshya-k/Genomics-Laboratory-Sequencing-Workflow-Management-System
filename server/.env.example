# -------------------------------------------------------------
# Genomics Laboratory Sequencing Workflow Management System
# Backend Environment Configuration Template
# -------------------------------------------------------------

# Server Port (Cloud platforms like Render/Railway set this automatically)
PORT=5000

# Node Environment ('development' or 'production')
NODE_ENV=production

# -------------------------------------------------------------
# MongoDB Connection String
# -------------------------------------------------------------
# For Local Development:
# MONGODB_URI=mongodb://localhost:27017/genomics_workflow
#
# For MongoDB Atlas (Cloud):
# Replace <username>, <password>, and <cluster-url> with your Atlas details:
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/genomics_workflow?retryWrites=true&w=majority

# -------------------------------------------------------------
# Authentication & Security
# -------------------------------------------------------------
# Strong random secret key for JWT token signing
JWT_SECRET=genomics_super_secret_jwt_key_2026_workflow_mgmt

# Allowed Client Origin for CORS (comma-separated if multiple, e.g. local + deployed frontend)
# If deploying backend and frontend together on Render/Railway, this is optional.
# If frontend is on Vercel: https://your-app-name.vercel.app
CLIENT_ORIGIN=http://localhost:5173,https://your-frontend-domain.vercel.app
